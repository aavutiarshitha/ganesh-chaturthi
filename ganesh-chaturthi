<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Happy Ganesh Chaturthi</title>


<style>

/* ================= BASIC ================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    overflow: hidden;

    font-family: Georgia, serif;

    background: #E8D8C8;
}


/* ================= OPENING SCREEN ================= */

.opening {

    position: fixed;

    inset: 0;

    z-index: 100;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    text-align: center;

    background:
        radial-gradient(
            circle at center,
            #F8EEE6 0%,
            #E8D8C8 45%,
            #C9AD98 100%
        );

    transition: 1.5s ease;
}


/* Opening fade animation */

.opening.hide {

    opacity: 0;

    transform: scale(1.3);

    pointer-events: none;
}


/* Ganesh */

.ganesh {

    font-size: 100px;

    animation:
        floating 2.5s ease-in-out infinite,
        glow 2s ease-in-out infinite;

    filter:
        drop-shadow(
            0 0 20px rgba(150,110,75,0.5)
        );
}


/* Opening heading */

.opening h1 {

    margin-top: 20px;

    font-size:
        clamp(30px, 8vw, 55px);

    color: #7D5942;

    text-shadow:
        2px 3px 6px rgba(80,50,30,0.2);
}


/* Small text */

.opening p {

    margin-top: 12px;

    font-size: 19px;

    color: #806653;
}


/* Tap button */

.tap-button {

    margin-top: 40px;

    padding: 17px 42px;

    border: 2px solid #B28A67;

    border-radius: 50px;

    background: rgba(255,255,255,0.35);

    color: #6F4E3A;

    font-size: 21px;

    font-family: Georgia, serif;

    cursor: pointer;

    box-shadow:
        0 5px 20px rgba(100,70,50,0.2);

    animation: pulse 1.5s infinite;

    transition: 0.3s;
}

.tap-button:hover {

    background: rgba(255,255,255,0.6);

    transform: scale(1.05);
}

.tap-button:active {

    transform: scale(0.95);
}


/* ================= MAIN BACKGROUND ================= */

.card {

    min-height: 100vh;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 20px;

    background:
        radial-gradient(
            circle at center,
            #F8EEE6,
            #E2CDBB 55%,
            #C5A58D
        );

    opacity: 0;

    transition: 1.5s ease;
}


/* Show card */

.card.show {

    opacity: 1;
}


/* ================= WISH CARD ================= */

.wish-card {

    width: min(90%, 650px);

    padding: 40px 25px;

    text-align: center;

    border-radius: 30px;

    background:
        rgba(255, 248, 240, 0.82);

    border: 2px solid #C4A484;

    box-shadow:
        0 15px 40px rgba(90,65,45,0.25),
        inset 0 0 30px rgba(255,255,255,0.5);

    animation:
        cardAppear 1.5s ease;
}


/* Top decoration */

.top {

    font-size: 32px;

    letter-spacing: 8px;

    margin-bottom: 8px;
}


/* Ganesh inside card */

.card-ganesh {

    font-size: 75px;

    animation:
        floating 2.5s infinite ease-in-out;

    filter:
        drop-shadow(
            0 0 15px rgba(150,110,75,0.5)
        );
}


/* Main heading */

.wish-card h1 {

    margin-top: 15px;

    font-size:
        clamp(34px, 8vw, 58px);

    color: #8B6045;

    text-shadow:
        1px 2px 5px rgba(80,50,30,0.15);
}


/* Ganpati text */

.wish-card h2 {

    margin-top: 12px;

    font-size:
        clamp(20px, 5vw, 30px);

    color: #795A46;
}


/* Divider */

.divider {

    width: 75%;

    height: 2px;

    margin: 25px auto;

    background: #B99370;

    box-shadow:
        0 0 8px rgba(170,130,90,0.5);
}


/* Main message */

.message {

    font-size:
        clamp(18px, 4vw, 23px);

    line-height: 1.7;

    color: #604A3B;
}


/* Highlight */

.highlight {

    margin-top: 25px;

    font-size:
        clamp(21px, 5vw, 30px);

    line-height: 1.5;

    font-weight: bold;

    color: #966B4D;

    text-shadow:
        0 1px 3px rgba(100,70,50,0.15);
}


/* Bottom decoration */

.bottom {

    margin-top: 25px;

    font-size: 32px;

    letter-spacing: 8px;
}


/* ================= FALLING FLOWERS ================= */

.flower {

    position: fixed;

    top: -50px;

    z-index: 200;

    pointer-events: none;

    animation:
        fall linear forwards;
}


@keyframes fall {

    0% {

        transform:
            translateY(-50px)
            rotate(0deg);

        opacity: 1;
    }

    100% {

        transform:
            translateY(110vh)
            rotate(720deg);

        opacity: 0;
    }
}


/* ================= SPARKLES ================= */

.sparkle {

    position: fixed;

    width: 5px;

    height: 5px;

    border-radius: 50%;

    background: #B28A67;

    box-shadow:
        0 0 8px #D8BFA8;

    pointer-events: none;

    animation:
        sparkle 2s infinite;
}


@keyframes sparkle {

    0%, 100% {

        opacity: 0;

        transform: scale(0);
    }

    50% {

        opacity: 1;

        transform: scale(1.5);
    }
}


/* ================= ANIMATIONS ================= */

@keyframes floating {

    0%, 100% {

        transform:
            translateY(0);
    }

    50% {

        transform:
            translateY(-15px);
    }
}


@keyframes glow {

    0%, 100% {

        filter:
            drop-shadow(
                0 0 10px rgba(150,110,75,0.3)
            );
    }

    50% {

        filter:
            drop-shadow(
                0 0 28px rgba(150,110,75,0.6)
            );
    }
}


@keyframes pulse {

    0%, 100% {

        transform: scale(1);

        box-shadow:
            0 5px 15px
            rgba(100,70,50,0.2);
    }

    50% {

        transform: scale(1.07);

        box-shadow:
            0 5px 25px
            rgba(100,70,50,0.4);
    }
}


@keyframes cardAppear {

    from {

        opacity: 0;

        transform:
            scale(0.5)
            translateY(80px);
    }

    to {

        opacity: 1;

        transform:
            scale(1)
            translateY(0);
    }
}


/* ================= MOBILE ================= */

@media (max-width: 500px) {

    .ganesh {
        font-size: 75px;
    }

    .card-ganesh {
        font-size: 60px;
    }

    .wish-card {
        padding: 30px 18px;
    }

    .opening p {
        font-size: 17px;
    }

    .tap-button {
        font-size: 19px;
        padding: 15px 32px;
    }

}

</style>

</head>


<body>


<!-- ================================================= -->
<!--                 OPENING SCREEN                    -->
<!-- ================================================= -->

<div class="opening" id="opening">


    <div class="ganesh">
        🐘
    </div>


    <h1>
        Ganpati Bappa Morya
    </h1>


    <p>
        🙏 A special wish for you 🙏
    </p>


    <button
        class="tap-button"
        onclick="openCard()">

        ✨ Tap to Open ✨

    </button>


</div>



<!-- ================================================= -->
<!--                  WISH CARD                        -->
<!-- ================================================= -->

<div class="card" id="card">


    <div class="wish-card">


        <div class="top">
            🪔 🌸 🪔
        </div>


        <div class="card-ganesh">
            🐘
        </div>


        <h1>
            Happy Ganesh Chaturthi
        </h1>


        <h2>
            🙏 गणपति बप्पा मोरया 🙏
        </h2>


        <div class="divider"></div>


        <p class="message">

            May Lord Ganesha bless you and your
            family with happiness, peace,
            prosperity and success.

            <br><br>

            May He remove every obstacle from
            your path and fill your life with
            love, positivity and beautiful moments. ✨

        </p>


        <p class="highlight">

            🌺 Wishing You & Your Family 🌺

            <br>

            A Very Happy & Blessed

            <br>

            Ganesh Chaturthi!

        </p>


        <div class="bottom">
            🪔 🌸 🙏 🌸 🪔
        </div>


    </div>


</div>



<script>


/* ================================================= */
/*                  OPEN CARD                         */
/* ================================================= */

function openCard() {


    const opening =
        document.getElementById("opening");


    const card =
        document.getElementById("card");


    /* Fade opening screen */

    opening.classList.add("hide");


    /* Show wish card */

    setTimeout(function() {


        opening.style.display = "none";


        card.classList.add("show");


        /* Start animations */

        createFlowers();

        createSparkles();


    }, 1000);

}



/* ================================================= */
/*                 FALLING FLOWERS                    */
/* ================================================= */

function createFlowers() {


    const flowers = [

        "🌸",
        "🌺",
        "🌼",
        "🌻",
        "🌷",
        "✨"

    ];


    for (let i = 0; i < 80; i++) {


        const flower =
            document.createElement("div");


        flower.className =
            "flower";


        flower.innerText =
            flowers[
                Math.floor(
                    Math.random()
                    * flowers.length
                )
            ];


        flower.style.left =
            Math.random() * 100 + "vw";


        flower.style.fontSize =
            (15 + Math.random() * 20)
            + "px";


        flower.style.animationDuration =
            (4 + Math.random() * 5)
            + "s";


        flower.style.animationDelay =
            Math.random() * 4
            + "s";


        document.body.appendChild(
            flower
        );

    }

}



/* ================================================= */
/*                  SPARKLES                         */
/* ================================================= */

function createSparkles() {


    for (let i = 0; i < 45; i++) {


        const sparkle =
            document.createElement("div");


        sparkle.className =
            "sparkle";


        sparkle.style.left =
            Math.random() * 100
            + "vw";


        sparkle.style.top =
            Math.random() * 100
            + "vh";


        sparkle.style.animationDelay =
            Math.random() * 3
            + "s";


        document.body.appendChild(
            sparkle
        );

    }

}

</script>


</body>

</html>
